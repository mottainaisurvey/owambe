// ─────────────────────────────────────────────────────
// Owambe.com — Prisma Database Schema
// PostgreSQL (uuid-ossp for IDs)
// ─────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ─── ENUMS ───────────────────────────────────────────
enum UserRole {
  PLANNER
  VENDOR
  CONSUMER
  ADMIN
  HOST       // Phase A: Stays mode
  OPERATOR   // Phase A: Experiences mode
}
enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

// Phase A: Platform mode enum
enum PlatformMode {
  EVENTS
  STAYS
  EXPERIENCES
}

// Phase B: User mode enum (per-user active mode, distinct from platform mode)
enum UserMode {
  EVENTS
  STAYS
  EXPERIENCES
  FULL  // Access to all modes
}

// Phase A.5: Currency enum — per brief Q&A v1.1 Q05 (Paystack three-currency set)
enum Currency {
  NGN
  USD
  GBP
}

// Phase A.5: Channel origin enum
enum ChannelOrigin {
  DIRECT
  COASTAL_CORRIDOR
  BOOKING_COM
  AIRBNB
  HOTELS_NG
  GETYOURGUIDE
  VIATOR
}

// Phase A.5: Cohort type enum — role-type model per brief Q&A v1.1 Q02
enum CohortType {
  COASTAL_CORRIDOR_HOST
  COASTAL_CORRIDOR_OPERATOR
  BOTH
  BETA        // Phase B: Beta cohort
  PARTNER     // Phase B: Partner cohort
  INTERNAL    // Phase B: Internal team cohort
  PRESS       // Phase B: Press/media cohort
}

// Phase A.5: Cohort code status enum
enum CohortCodeStatus {
  ACTIVE
  USED
  EXPIRED
  EXHAUSTED
  REVOKED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
  CANCELLED
}
enum EventFormat {
  IN_PERSON
  VIRTUAL
  HYBRID
}
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}
enum BookingType {
  INSTANT
  RFQ
}
enum VendorCategory {
  // ── Events ──────────────────────────────────────────
  VENUE
  CATERING
  WEDDING_CAKES
  BAR_BEVERAGE
  AV_PRODUCTION
  CONFERENCE_AV
  PHOTOGRAPHY_VIDEO
  PRE_WEDDING
  DECOR_FLORALS
  ENTERTAINMENT
  MC_EMCEE
  MAKEUP_ARTIST
  SPEAKER
  ASO_EBI
  BRIDAL_JEWELLERY
  USHERS_HOSTESSES
  EVENT_SECURITY
  EVENT_COORDINATION
  BRANDING_SIGNAGE
  SOUVENIR_SOURCING
  SET_DESIGN
  CHILDRENS_PARTY
  // ── Stays ───────────────────────────────────────────
  CLEANING_HOUSEKEEPING
  PROPERTY_MAINTENANCE
  LAUNDRY
  PROPERTY_SECURITY
  INTERIOR_DESIGN
  LISTING_PHOTOGRAPHY
  LOCAL_TRANSPORT
  AIRPORT_PICKUP
  IN_PROPERTY_CATERING
  CONCIERGE
  // ── Experiences ─────────────────────────────────────
  TOUR_GUIDES
  BOAT_CHARTER
  EQUIPMENT_RENTAL
  TOURISM_TRANSPORT
  WELLNESS_SPA
  CULTURAL_WORKSHOPS
  ADVENTURE_ACTIVITIES
  SUB_GUIDES
  TRAVEL_DOCUMENTATION
}
enum VendorStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}
enum PaymentStatus {
  PENDING
  DEPOSIT_PAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}
enum ContractStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  FULLY_SIGNED
  VOID
  EXPIRED
}
enum SignerRole {
  PLANNER
  VENDOR
  WITNESS
}
enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}
enum TicketStatus {
  ACTIVE
  SOLD_OUT
  PAUSED
}
enum CheckInStatus {
  REGISTERED
  CHECKED_IN
  NO_SHOW
}
enum SpeakerStatus {
  INVITED
  CONFIRMED
  DECLINED
  PENDING
}
enum SponsorTier {
  GOLD
  SILVER
  BRONZE
}
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  QUOTE_RECEIVED
  MESSAGE_RECEIVED
  EVENT_REMINDER
  REVIEW_RECEIVED
  VENDOR_VERIFIED
}
enum PlanType {
  STARTER
  GROWTH
  SCALE
}

// Phase A: Property types for Stays mode
enum PropertyType {
  HOTEL
  GUESTHOUSE
  VILLA
  APARTMENT
  RESORT
  LODGE
  BOUTIQUE_HOTEL
  SERVICED_APARTMENT
}

// Phase A: Room types for Stays mode
enum RoomType {
  STANDARD
  DELUXE
  SUITE
  EXECUTIVE
  FAMILY
  TWIN
  SINGLE
  PRESIDENTIAL
}

// Phase A: Experience categories
enum ExperienceType {
  CULTURAL_TOUR
  FOOD_TASTING
  ADVENTURE
  WELLNESS_SPA
  NIGHTLIFE
  WORKSHOP
  SPORTS
  SIGHTSEEING
  PRIVATE_DINING
  MUSIC_PERFORMANCE
}

// Phase A: Stay booking status
enum StayBookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  REFUNDED    // CC-canonical: aligns with CC ReservationStatus.REFUNDED
}

// Phase A: Experience booking status
enum ExperienceBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  REFUNDED    // CC-canonical: aligns with CC ExperienceBookingStatus.REFUNDED
}

// ─── USERS ───────────────────────────────────────────
model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String       @unique
  passwordHash     String?
  role             UserRole
  authProvider     AuthProvider @default(EMAIL)
  providerUserId   String?
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  isEmailVerified  Boolean      @default(false)
  isPhoneVerified  Boolean      @default(false)
  isActive         Boolean      @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Phase A: Mode infrastructure
  activeMode       PlatformMode  @default(EVENTS)
  availableModes   PlatformMode[] @default([EVENTS])
  cohortCode       String?       // Coastal Corridor cohort code
  // Phase A.5: Cohort membership fields
  cohortMember     Boolean       @default(false)
  cohortType       CohortType?
  cohortStartDate  DateTime?
  cohortEndDate    DateTime?
  preferredCurrency Currency     @default(NGN)
  onboardedAt      DateTime?
  channelOrigin    ChannelOrigin @default(DIRECT)

  // Relations
  planner          Planner?
  vendor           Vendor?
  consumer         Consumer?
  host             Host?
  operator         Operator?
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  sentMessages     Message[]    @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  stayBookingsAsGuest       StayBooking[]       @relation("StayBookingGuest")
  experienceBookingsAsGuest ExperienceBooking[] @relation("ExperienceBookingGuest")
  @@index([email])
  @@index([role])
  @@index([activeMode])
  @@index([cohortCode])
  @@map("users")
}
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([token])
  @@map("refresh_tokens")
}
// ─── PLANNER ─────────────────────────────────────────
model Planner {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @db.Uuid
  businessName    String?
  businessType    String?
  companyName     String?   // Display name for white-label portals
  city            String?
  state           String?
  country         String    @default("NG")
  website         String?
  bio             String?
  logoUrl         String?
  plan            PlanType  @default(STARTER)
  planExpiresAt   DateTime?
  paystackSubAccountCode String?
  paystackSubAccountId   String?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
  bookings  Booking[]
  contracts Contract[]
  crmConnections CrmConnection[]
  instalmentPlans InstalmentPlan[]
  tenant    Tenant?
  @@map("planners")
}
// ─── VENDOR ──────────────────────────────────────────
model Vendor {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String         @unique @db.Uuid
  businessName        String
  category            VendorCategory
  description         String?
  city                String?
  state               String?
  country             String         @default("NG")
  address             String?
  latitude            Decimal?       @db.Decimal(10, 7)
  longitude           Decimal?       @db.Decimal(10, 7)
  coverImageUrl       String?
  galleryUrls         String[]       @default([])
  basePrice           Decimal?       @db.Decimal(12, 2)
  currency            String         @default("NGN")
  rating              Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount         Int            @default(0)
  status              VendorStatus   @default(PENDING)
  isActive            Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  verifiedAt          DateTime?
  verificationNotes   String?
  paystackSubAccountCode String?
  paystackSubAccountId   String?
  bankCode            String?
  bankAccountNumber   String?
  bankAccountName     String?
  phone               String?        // Contact phone number
  shortBio            String?        // Short bio for vendor profile
  serviceRadius       Int?           // Service radius in km
  launchBonusActive   Boolean        @default(false) // Launch bonus promotion flag
  launchBonusExpiresAt DateTime?      // When the launch bonus expires
  // Phase A: Vendor marketplace fields
  slug                String?        @unique
  minPrice            Decimal?       @db.Decimal(12, 2)
  maxPrice            Decimal?       @db.Decimal(12, 2)
  bookingCount        Int            @default(0)
  commissionRate      Decimal        @default(10) @db.Decimal(5, 2)
  rejectionReason     String?
  featuredUntil       DateTime?
  isInstantBook       Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  // VENDOR-MARKETPLACE-EXPANSION-01: Layer 2 tag system
  vendorCategoryId String?  @db.Uuid  // FK to VendorCategoryLookup (nullable for migration safety)
  vendorCategory   VendorCategoryLookup? @relation(fields: [vendorCategoryId], references: [id])
  tags             VendorTag[]  @relation("VendorToVendorTag")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages      VendorPackage[]
  availability  VendorAvailability[]
  bookings      Booking[]
  reviews       Review[]
  quotes        Quote[]
  contracts     Contract[]
  portfolioItems PortfolioItem[]
  @@index([category])
  @@index([vendorCategoryId])
  @@index([city])
  @@index([status])
  @@index([latitude, longitude])
  @@index([slug])
  @@map("vendors")
}
model VendorPackage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  duration    String?
  includes    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings Booking[]
  @@map("vendor_packages")
}
model VendorAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @db.Uuid
  date        DateTime @db.Date
  isAvailable Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@unique([vendorId, date])
  @@index([vendorId, date])
  @@map("vendor_availability")
}

// ─── HOST (Phase A: Stays mode) ──────────────────────
model Host {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @db.Uuid
  businessName    String?
  city            String?
  state           String?
  country         String    @default("NG")
  phone           String?
  bio             String?
  logoUrl         String?
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  isApproved      Boolean   @default(false)  // E2: explicit approval status, independent of isVerified
  approvedAt      DateTime?                  // E2: timestamp of most recent approval action
  paystackSubAccountCode String?
  paystackSubAccountId   String?
  bankCode        String?
  bankAccountNumber String?
  bankAccountName String?
  rating          Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]

  @@map("hosts")
}

// ─── PROPERTY (Phase A: Stays mode) ──────────────────
model Property {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId          String       @db.Uuid
  name            String
  slug            String       @unique
  description     String?
  propertyType    PropertyType
  city            String
  state           String?
  country         String       @default("NG")
  address         String?
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  coverImageUrl   String?
  galleryUrls     String[]     @default([])
  amenities       String[]     @default([])
  checkInTime     String?      // e.g. "14:00"
  checkOutTime    String?      // e.g. "11:00"
  houseRules      String?
  cancellationPolicy String?
  isActive        Boolean      @default(true)
  isApproved      Boolean      @default(false)  // E2: explicit approval status, independent of isActive
  approvedAt      DateTime?                     // E2: timestamp of most recent approval action
  isFeatured      Boolean      @default(false)
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  reviewCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Phase B: Coastal Corridor channel sync fields
  coastalCorridorPropertyId String?  // CC-assigned property ID after push registration
  coastalCorridorSyncedAt   DateTime? // Last successful sync timestamp
  coastalCorridorListingUrl String?  // CC listing URL

  host         Host           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  rooms        Room[]
  stayBookings StayBooking[]
  calendarEntries CalendarEntry[]

  @@index([hostId])
  @@index([city])
  @@index([propertyType])
  @@index([latitude, longitude])
  @@map("properties")
}

// ─── ROOM (Phase A: Stays mode) ──────────────────────
model Room {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String   @db.Uuid
  name            String
  roomType        RoomType
  description     String?
  capacity        Int      @default(2)
  bedCount        Int      @default(1)
  bathCount       Int      @default(1)
  pricePerNight   Decimal  @db.Decimal(12, 2)
  currency        String   @default("NGN")
  amenities       String[] @default([])
  imageUrls       String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Phase B: Coastal Corridor channel sync fields
  coastalCorridorRoomId     String?  // CC-assigned room ID after push registration

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stayBookings StayBooking[]
  calendarEntries CalendarEntry[]

  @@index([propertyId])
  @@index([roomType])
  @@map("rooms")
}

// ─── STAY BOOKING (Phase A: Stays mode) ──────────────
model StayBooking {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference       String            @unique
  propertyId      String            @db.Uuid
  roomId          String            @db.Uuid
  guestUserId     String?           @db.Uuid
  guestId         String?           @db.Uuid  // Alias for guestUserId (Phase A compatibility)
  guestName       String
  guestEmail      String
  guestPhone      String?
  checkInDate     DateTime          @db.Date
  checkOutDate    DateTime          @db.Date
  nights          Int
  guestCount      Int               @default(1)
  totalAmount     Decimal           @db.Decimal(12, 2)
  depositAmount   Decimal           @db.Decimal(12, 2)
  currency        String            @default("NGN")
  status          StayBookingStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING)
  paystackRef     String?
  specialRequests String?
  cancellationReason String?
  cancelledAt     DateTime?
  cancelledBy     String?           // userId of who cancelled
  confirmedAt     DateTime?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  // Channel integration fields (Phase A.5: Coastal Corridor → Phase 5.2 generalised)
  channelOrigin   ChannelOrigin     @default(DIRECT)
  channelId       String?           @map("channel_id")  // FK to Channel registry (Brief B Rev 2)
  channel         Channel?          @relation(fields: [channelId], references: [id])
  externalRef     String?           // CC reservation ID (or partner equivalent post-generalisation)
  /// Owambe's own property ID echoed back in the bilateral contract payload per § 07 idempotency key shape.
  /// Represents Owambe's authoritative property identifier as it appears on the wire to the partner channel.
  externalPropertyId String?        // DB column: externalPropertyId (camelCase; no @map needed)
  /// Channel partner's native property ID for property reconciliation.
  /// Captures the partner's authoritative property identifier in their own system.
  /// Renamed from ccPropertyId per Brief B Rev 2 Operation 2 (OWB-PHASE-E-02 scaffold preserved).
  externalPartnerPropertyId String? @map("external_partner_property_id")
  channelCommissionAmount Decimal?  @db.Decimal(12, 2)
  channelCommissionPercent Decimal? @db.Decimal(5, 2)
  netToHost       Decimal?          @db.Decimal(12, 2)
  paystackReference String?         // Paystack reference from Coastal Corridor
  refundAmount    Decimal?          @db.Decimal(12, 2)
  refundCurrency  String?
  numberOfGuests  Int?              // Alias for guestCount from CC payload
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  guest    User?    @relation("StayBookingGuest", fields: [guestUserId], references: [id])
  commissionAuditLogs CommissionAuditLog[]

  @@index([propertyId])
  @@index([roomId])
  @@index([guestEmail])
  @@index([status])
  @@index([checkInDate])
  @@index([channelId])
  @@index([externalRef])
  @@map("stay_bookings")
}

// ─── OPERATOR (Phase A: Experiences mode) ────────────
model Operator {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @db.Uuid
  businessName    String?
  city            String?
  state           String?
  country         String    @default("NG")
  phone           String?
  bio             String?
  logoUrl         String?
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  isApproved      Boolean   @default(false)  // E2: explicit approval status, independent of isVerified
  approvedAt      DateTime?                  // E2: timestamp of most recent approval action
  paystackSubAccountCode String?
  paystackSubAccountId   String?
  bankCode        String?
  bankAccountNumber String?
  bankAccountName String?
  rating          Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]

  @@map("operators")
}

// ─── EXPERIENCE (Phase A: Experiences mode) ──────────
model Experience {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId      String         @db.Uuid
  name            String
  slug            String         @unique
  description     String?
  experienceType  ExperienceType
  city            String
  state           String?
  country         String         @default("NG")
  address         String?
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)
  coverImageUrl   String?
  galleryUrls     String[]       @default([])
  durationMinutes Int?
  maxGroupSize    Int?
  minGroupSize    Int            @default(1)
  pricePerPerson  Decimal        @db.Decimal(12, 2)
  currency        String         @default("NGN")
  includes        String[]       @default([])
  requirements    String[]       @default([])
  languages       String[]       @default(["English"])
  meetingDetails  String?                         // C1: meeting point / instructions for confirmed bookings
  isActive        Boolean        @default(false) // C1: default false (DRAFT state per lifecycle model)
  isApproved      Boolean        @default(false)  // E2: explicit approval status, independent of isActive
  approvedAt      DateTime?                       // E2: timestamp of most recent approval action
  isFeatured      Boolean        @default(false)
  rating          Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  operator            Operator              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  availableSlots      ExperienceSlot[]
  experienceBookings  ExperienceBooking[]

  @@index([operatorId])
  @@index([city])
  @@index([experienceType])
  @@index([latitude, longitude])
  @@map("experiences")
}

// ─── EXPERIENCE SLOT (Phase A: Experiences mode) ─────
model ExperienceSlot {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experienceId    String     @db.Uuid
  startTime       DateTime
  endTime         DateTime
  capacity        Int
  bookedCount     Int        @default(0)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  // C2: Recurrence fields (stored-rule-with-materialised-instances model)
  rruleString     String?    // RFC 5545 RRULE string; set on parent row only
  timezone        String?    // IANA timezone at rule authoring time (e.g. 'Africa/Lagos')
  parentSlotId    String?    @db.Uuid  // FK to parent slot row; set on child instance rows

  experience         Experience          @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  experienceBookings ExperienceBooking[]
  // C2: Self-relation for parent/child instance grouping
  parentSlot      ExperienceSlot?  @relation("SlotInstances", fields: [parentSlotId], references: [id], onDelete: SetNull)
  childSlots      ExperienceSlot[] @relation("SlotInstances")

  @@index([experienceId])
  @@index([startTime])
  @@index([parentSlotId])
  @@map("experience_slots")
}

// ─── EXPERIENCE BOOKING (Phase A: Experiences mode) ──
model ExperienceBooking {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference       String                  @unique
  experienceId    String                  @db.Uuid
  slotId          String                  @db.Uuid
  guestUserId     String?                 @db.Uuid
  guestId         String?                 @db.Uuid  // Alias for guestUserId (Phase A compatibility)
  guestName       String
  guestEmail      String
  guestPhone      String?
  guestCount      Int                     @default(1)
  totalAmount     Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("NGN")
  status          ExperienceBookingStatus @default(PENDING)
  paymentStatus   PaymentStatus           @default(PENDING)
  paystackRef     String?
  specialRequests String?
  cancellationReason String?
  cancelledAt     DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  // Channel integration fields (Phase A.5: Coastal Corridor → Phase 5.2 generalised)
  channelOrigin   ChannelOrigin          @default(DIRECT)
  channelId       String?                @map("channel_id")  // FK to Channel registry (Brief B Rev 2)
  channel         Channel?               @relation(fields: [channelId], references: [id])
  externalRef     String?                // CC booking ID (or partner equivalent post-generalisation)
  externalExperienceId String?           // CC experience ID (or partner equivalent)
  channelCommissionAmount Decimal?       @db.Decimal(12, 2)
  channelCommissionPercent Decimal?      @db.Decimal(5, 2)
  netToOperator   Decimal?               @db.Decimal(12, 2)
  paystackReference String?              // Paystack reference from Coastal Corridor
  numberOfParticipants Int?              // Alias for guestCount from CC payload
  participantNames String[]              // List of participant names
  pickupRequested Boolean                @default(false)
  pickupAddress   String?
  depositAmount   Decimal                @default(0) @db.Decimal(12, 2)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  experience Experience     @relation(fields: [experienceId], references: [id])
  slot       ExperienceSlot @relation(fields: [slotId], references: [id])
  guest      User?          @relation("ExperienceBookingGuest", fields: [guestUserId], references: [id])

  @@index([experienceId])
  @@index([slotId])
  @@index([guestEmail])
  @@index([status])
  @@index([channelId])
  @@index([externalRef])
  @@map("experience_bookings")
}

