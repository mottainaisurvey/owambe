// ─── CRM INTEGRATION ─────────────────────────────────
enum CrmProvider {
  SALESFORCE
  HUBSPOT
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
  PARTIAL
}

enum SyncDirection {
  PUSH
  PULL
  BIDIRECTIONAL
}

model CrmConnection {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plannerId         String      @db.Uuid
  provider          CrmProvider
  isActive          Boolean     @default(true)
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  instanceUrl       String?
  portalId          String?
  syncDirection     SyncDirection @default(BIDIRECTIONAL)
  syncAttendees     Boolean     @default(true)
  syncBookings      Boolean     @default(true)
  syncContacts      Boolean     @default(true)
  autoSyncEnabled   Boolean     @default(true)
  syncIntervalHours Int         @default(6)
  attendeeFieldMap  Json        @default("{}")
  bookingFieldMap   Json        @default("{}")
  crmContactOwnerId String?
  crmPipelineId     String?
  lastSyncAt        DateTime?
  lastSyncStatus    SyncStatus  @default(IDLE)
  lastSyncError     String?
  totalSynced       Int         @default(0)
  totalErrors       Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  planner  Planner      @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  syncLogs CrmSyncLog[]
  @@unique([plannerId, provider])
  @@map("crm_connections")
}

model CrmSyncLog {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId    String        @db.Uuid
  entityType      String
  entityId        String
  crmId           String?
  direction       SyncDirection
  status          SyncStatus
  errorMessage    String?
  payload         Json?
  durationMs      Int?
  syncedAt        DateTime      @default(now())
  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId])
  @@index([entityType, entityId])
  @@index([syncedAt])
  @@map("crm_sync_logs")
}

// ─── INSTALMENT PAYMENT PLANS ────────────────────────
enum InstalmentStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
  PAUSED
}

enum InstalmentPaymentStatus {
  SCHEDULED
  PENDING
  PROCESSING
  PAID
  FAILED
  WAIVED
}

model InstalmentPlan {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference           String          @unique
  bookingId           String          @db.Uuid
  plannerId           String?         @db.Uuid
  consumerId          String?         @db.Uuid
  totalAmount         Decimal         @db.Decimal(12, 2)
  instalmentCount     Int
  instalmentAmount    Decimal         @db.Decimal(12, 2)
  serviceFeeRate      Decimal         @default(3.5) @db.Decimal(5, 2)
  serviceFeeAmount    Decimal         @db.Decimal(12, 2)
  grandTotal          Decimal         @db.Decimal(12, 2)
  currency            String          @default("NGN")
  paystackAuthCode    String?
  paystackCustomerCode String?
  paystackEmail       String?
  status              InstalmentStatus @default(ACTIVE)
  amountPaid          Decimal         @default(0) @db.Decimal(12, 2)
  nextDueDate         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  completedAt         DateTime?
  defaultedAt         DateTime?
  failureCount        Int             @default(0)
  startDate           DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  booking   Booking          @relation(fields: [bookingId], references: [id])
  planner   Planner?         @relation(fields: [plannerId], references: [id])
  consumer  Consumer?        @relation(fields: [consumerId], references: [id])
  payments  InstalmentPayment[]
  @@index([bookingId])
  @@index([plannerId])
  @@index([consumerId])
  @@index([status])
  @@index([nextDueDate])
  @@map("instalment_plans")
}

model InstalmentPayment {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId              String                  @db.Uuid
  instalmentNumber    Int
  amount              Decimal                 @db.Decimal(12, 2)
  dueDate             DateTime
  paidAt              DateTime?
  status              InstalmentPaymentStatus @default(SCHEDULED)
  paystackReference   String?     @unique
  paystackChargeId    String?
  failureReason       String?
  retryCount          Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  plan InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@index([planId])
  @@index([dueDate])
  @@index([status])
  @@map("instalment_payments")
}

// ─── AGGREGATOR / DISTRIBUTION ───────────────────────
enum DistributionChannel {
  EVENTBRITE
  FACEBOOK_EVENTS
  GOOGLE_EVENTS
  WIDGET_EMBED
  COASTAL_CORRIDOR  // Phase B: Coastal Corridor distribution channel
  HOTELS_NG         // Phase B: Hotels.ng distribution channel
}

enum DistributionStatus {
  PENDING
  PUBLISHED
  FAILED
  UNPUBLISHED
}

model EventDistribution {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String               @db.Uuid
  channel         DistributionChannel
  status          DistributionStatus   @default(PENDING)
  externalId      String?
  externalUrl     String?
  externalRef     String?
  lastSyncAt      DateTime?
  lastError       String?
  publishedAt     DateTime?
  unpublishedAt   DateTime?
  clickCount      Int       @default(0)
  registrationCount Int     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, channel])
  @@index([eventId])
  @@map("event_distributions")
}

// ─── TENANT (Phase A: White-label portals) ───────────
model Tenant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plannerId       String    @unique @db.Uuid
  subdomain       String    @unique
  customDomain    String?   @unique
  name            String
  tagline         String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String    @default("#2D6A4F")
  accentColor     String    @default("#E76F2A")
  bgColor         String    @default("#FDFAF4")
  fontFamily      String    @default("Inter")
  metaTitle       String?
  metaDescription String?
  metaImage       String?
  socialLinks     Json      @default("{}")
  footerText      String?
  customCss       String?
  allowPublicReg  Boolean   @default(true)
  requireApproval Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  planner         Planner   @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  @@index([subdomain])
  @@index([customDomain])
  @@map("tenants")
}

// ─── CALENDAR ENTRY (Phase B: Stays mode date-level overrides) ─────────────
//
// Represents a single date's availability and pricing state for a room.
// Used for:
//   1. Host-managed blocks (isBlocked=true, reason e.g. "maintenance")
//   2. Pricing overrides (rate different from room base rate)
//   3. Minimum-stay overrides for specific dates
//   4. Syncing availability to Coastal Corridor (updateAvailability call)
//
// A date with no CalendarEntry is implicitly available at the room's base rate.

// ─── CHANNEL REGISTRY ENUMS (Brief A Rev 2 + Amendment-01) ─────────────────
enum ChannelAuthScheme {
  HMAC_SHA256
}

enum ChannelState {
  ACTIVE
  PAUSED
  DECOMMISSIONED
}

enum CalendarEntryStatus {
  AVAILABLE
  BLOCKED
  BOOKED       // Set automatically when a StayBooking covers this date
  MAINTENANCE
}

model CalendarEntry {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String              @db.Uuid
  roomId          String              @db.Uuid
  date            DateTime            @db.Date
  status          CalendarEntryStatus @default(AVAILABLE)
  rateOverride    Decimal?            @db.Decimal(12, 2)  // Null = use room base rate
  currency        String?             // Null = inherit from room
  minimumStay     Int?                // Minimum nights for this date
  maximumStay     Int?                // Maximum nights for this date
  closedReason    String?             // Human-readable reason for block
  // Coastal Corridor sync tracking
  ccSyncedAt      DateTime?           // When this entry was last pushed to CC
  ccSyncStatus    String?             // 'SYNCED' | 'PENDING' | 'FAILED'
  // Audit
  createdByUserId String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([propertyId, date])
  @@index([roomId, date])
  @@index([status])
  @@index([ccSyncStatus])
  @@map("calendar_entries")
}

// ─── COMMISSION AUDIT LOG (Phase C: OWB-C-08) ──────────────────────────────
// Immutable audit record created at the moment of every channel reservation.
// Records the commission calculation inputs and outputs for reconciliation.
model CommissionAuditLog {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stayBookingId               String   @db.Uuid
  reservationReference        String
  channelOrigin               String
  totalAmount                 Decimal  @db.Decimal(12, 2)
  currency                    String   @default("NGN")
  // Commission inputs
  cohortMember                Boolean  @default(false)
  cohortType                  String?
  appliedCommissionRate       Decimal  @db.Decimal(5, 2)
  rateSource                  String
  // Commission outputs
  channelCommissionAmount     Decimal  @db.Decimal(12, 2)
  channelCommissionPercent    Decimal  @db.Decimal(5, 2)
  netToHost                   Decimal  @db.Decimal(12, 2)
  // CC-provided values (for discrepancy detection)
  ccProvidedCommissionAmount  Decimal? @db.Decimal(12, 2)
  ccProvidedCommissionPercent Decimal? @db.Decimal(5, 2)
  ccProvidedNetToHost         Decimal? @db.Decimal(12, 2)
  // Discrepancy flag
  hasDiscrepancy              Boolean  @default(false)
  discrepancyNote             String?
  createdAt                   DateTime @default(now())

  stayBooking StayBooking @relation(fields: [stayBookingId], references: [id], onDelete: Cascade)

  @@index([stayBookingId])
  @@index([reservationReference])
  @@index([channelOrigin])
  @@index([createdAt])
  @@map("commission_audit_logs")
}

// ─── PORTFOLIO ITEM (Phase A: Vendor portfolio) ──────
model PortfolioItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String   @db.Uuid
  url         String
  caption     String?
  mediaType   String   @default("image") // image | video
  isMain      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@index([vendorId])
  @@map("portfolio_items")
}

// ─── WEBHOOK DELIVERY LOG (OWB-WAVE-4-01) ────────────────────────────────────
// Persists outbound webhook delivery attempts from Owambe→CC.
// One row per unique eventId; updated on each retry attempt.
model WebhookDeliveryLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String   @unique                    // owb-evt-{hex} — idempotency anchor
  eventType       String                              // e.g. reservation.guest_checked_in (spec-canonical post-Brief-D)
  channelSlug     String              @default("coastal-corridor") @map("channel_slug") // Brief D Rev 2 D5 correction
  targetUrl       String
  requestBody     String   @db.Text                  // first 5000 chars of outbound JSON
  httpStatus      Int?                               // last HTTP response status
  responseBody    String?  @db.Text                  // last HTTP response body (truncated)
  deliveryStatus  String   @default("PENDING")       // PENDING | DELIVERED | FAILED
  errorMessage    String?  @db.Text
  attemptCount    Int      @default(0)
  durationMs      Int?                               // last attempt duration in ms
  lastAttemptAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deliveryStatus])
  @@index([eventType])
  @@index([channelSlug])
  @@index([createdAt])
  @@map("webhook_delivery_logs")
}

// ─── RECONCILIATION (OWB-WAVE-4-03) ──────────────────────────────────────────

model ReconciliationRun {
  id                        String    @id                        // recon-{timestamp}-{hex}
  startedAt                 DateTime
  completedAt               DateTime?
  durationMs                Int?
  status                    String    @default("RUNNING")        // RUNNING | SUCCESS | PARTIAL | FAILED
  staysChecked              Int       @default(0)
  experiencesChecked        Int       @default(0)
  driftsDetected            Int       @default(0)
  autoCorrectionsApplied    Int       @default(0)
  manualReviewItemsFlagged  Int       @default(0)
  createdAt                 DateTime  @default(now())
  manualReviewItems         ReconciliationManualReview[]

  @@index([status])
  @@index([startedAt])
  @@map("reconciliation_runs")
}

model ReconciliationManualReview {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reconciliationRunId   String
  scope                 String                                   // STAYS | EXPERIENCES
  externalRef           String?                                  // CC-side ID
  owambeId              String?                                  // Owambe-side ID
  driftType             String                                   // STATUS_MISMATCH | MISSING_ON_OWAMBE | AMOUNT_DRIFT | etc.
  ccValue               String?  @db.Text
  owambeValue           String?  @db.Text
  note                  String   @db.Text
  resolvedAt            DateTime?
  resolvedBy            String?
  resolutionNote        String?  @db.Text
  createdAt             DateTime @default(now())
  reconciliationRun     ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)

  @@index([reconciliationRunId])
  @@index([scope])
  @@index([driftType])
  @@index([createdAt])
  @@map("reconciliation_manual_reviews")
}

// ─── CHANNEL REGISTRY (Brief A Rev 2 + Amendment-01) ─────────────────────────
// Canonical per-channel registry: identity + auth + capabilities + destination + state.
// Amendment-01: destinationUrl field added for per-channel outbound dispatch routing.
// Amendment-02: timestampHeader field to be added alongside Brief C execution.
model Channel {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  contactEmail    String?             @map("contact_email")

  // Auth shape (Brief A Rev 2 + Amendment-02)
  authScheme      ChannelAuthScheme   @default(HMAC_SHA256) @map("auth_scheme")
  hmacSecret      String?             @map("hmac_secret")
  signatureHeader String              @default("X-Signature") @map("signature_header")
  /// HMAC pair companion: per-channel timestamp header name for replay-protection construction.
  /// Non-nullable; NULL would create undefined HMAC pair construction state.
  /// Default 'X-Timestamp' per spec-canonical direction (Amendment-02 bilateral concurrence).
  timestampHeader String              @default("X-Timestamp") @map("timestamp_header")

  // Capabilities (Brief A Rev 2)
  supportsStays         Boolean       @default(false) @map("supports_stays")
  supportsExperiences   Boolean       @default(false) @map("supports_experiences")
  supportsEvents        Boolean       @default(false) @map("supports_events")
  supportsVendors       Boolean       @default(false) @map("supports_vendors")

  // Destination (Amendment-01)
  destinationUrl        String?       @map("destination_url")

  // Operational state (Brief A Rev 2)
  state           ChannelState        @default(ACTIVE)

  // Audit
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Reverse relations (Brief B Rev 2)
  stayBookings        StayBooking[]
  experienceBookings  ExperienceBooking[]

  @@index([slug])
  @@index([state])
  @@map("channels")
}

// ─── OWAMBE-INTEREST-CAPTURE-HARDENING-01 ────────────────────────────────────
// v2 lead infrastructure: DB persistence for cohort interest submissions
model CohortInterestSubmission {
  id                  String    @id @default(cuid())
  email               String    @db.VarChar(255)
  source              String    @db.VarChar(50)   // owambe-homepage | owambe-cohort-page | cc-for-operators | unknown
  submittedAt         DateTime  @default(now()) @map("submitted_at")
  ipAddress           String?   @db.VarChar(45)   @map("ip_address")
  userAgent           String?   @db.VarChar(500)  @map("user_agent")
  emailForwardStatus  String?   @db.VarChar(20)   @map("email_forward_status")  // 'sent' | 'failed' | null
  ackEmailStatus      String?   @db.VarChar(20)   @map("ack_email_status")      // 'sent' | 'failed' | null

  @@index([email, source])
  @@index([submittedAt])
  @@map("cohort_interest_submissions")
}
